# Maintainer: Sahrul Jamil <sahruljamil2@gmail.com>
pkgname=hyprpresenter
pkgver=0.1.0
pkgrel=1
pkgdesc="Presentation remote for Hyprland. Your Android phone becomes the clicker, with a gyro laser pointer, over your LAN"
arch=('x86_64')
url="https://github.com/ShrlJamil/hyprpresenter"
license=('MIT')
depends=('wayland' 'libxkbcommon')
makedepends=('cargo' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('50692d27241c8e94b62fcb7f089bf8cee216e7e24b11d706d984c949765d55ff')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 "target/release/hypresent" "$pkgdir/usr/bin/hypresent"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
